    {
      "slug": "thoth-browser",
      "name": "THOTH Browser",
      "url": "https://github.com/thothfnd/THOTH-Browser",
      "status": "Active development",
      "headline": "Privacy as architecture, not a checklist of settings.",
      "overview": "THOTH Browser treats privacy, anonymity and anti-correlation as architectural constraints. Identity is compartmentalized by context; storage, execution and network boundaries are explicit; routing can be separated; fingerprint resistance is treated as part of the model; and important properties are designed to be testable rather than merely asserted by the interface.",
      "pillars": [
        "identity isolation",
        "network boundaries",
        "fingerprint resistance",
        "verification"
